# StudyPlanet Backend Environment Variables Template
# Copy this file to a new file named '.env' in this directory and populate with your credentials.

# Server Configuration
PORT=4000
HOST=0.0.0.0

# Database Configuration
# MongoDB connection URI (e.g. Atlas connection string or local MongoDB URI)
MONGODBURL=mongodb://127.0.0.1:27017/studyplanet

# JWT Config
# Secret key used for signing JSON Web Tokens (JWT) for authentication
JWT_SECRET=generate_a_secure_long_secret_key_here

# Mailer Configuration (Nodemailer SMTP settings)
# For Gmail, set MAIL_HOST to 'smtp.gmail.com' and use an App Password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_sender_email@gmail.com
MAIL_PASS=your_smtp_app_password_here

# Cloudinary Configuration (For media storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Configuration (For payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cloudinary media folder configurations
COURSE_THUMBNAIL_FOLDER=course_thumbnails
